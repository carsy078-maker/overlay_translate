; Discord 오버레이 번역기 설정 (샘플)
; 이 파일을 translator.ini 로 복사해서 값을 채운다. exe(또는 스크립트) 옆에 두면
; 적용된다. 없으면 기본값으로 동작. 환경변수 DTL_<대문자키> 로도 덮어쓸 수 있다.
;
; 주의: 실제 translator.ini 는 .gitignore 되어 커밋되지 않는다(키/토큰 보호).

[translator]
; ── 번역 ──
target_lang = ko            ; 목표 언어 (ko, en, ja, zh-CN ...)
translation_provider = google  ; google(무료,키X) | gemini(LLM) | proxy(배포용)
; Gemini 쓰려면 위를 gemini로 바꾸고 아래 키를 채운다.
; 키는 https://aistudio.google.com 에서 무료 발급(카드 불필요).
gemini_api_key =            ; Google AI Studio API 키
gemini_model = gemini-flash-latest  ; 최신 flash 별칭(무료 티어)
; proxy: 남에게 배포할 때. 키는 서버(프록시)에만 두고 exe엔 주소/토큰만. proxy/README.md
proxy_url =                 ; 예: https://xxx.workers.dev
proxy_token =               ; 남용 방지 토큰(키 아님)
translate_workers = 4       ; 동시 번역 워커 수 (많을수록 빠르나 차단 위험↑)
translate_max_retries = 3   ; 번역 실패 시 재시도 횟수
translate_retry_delay = 0.7 ; 재시도 간격(초), 점증

; ── 스캔 ──
scan_interval_sec = 0.35    ; 화면 스캔 주기(초)
min_text_len = 2            ; 이 글자 수 미만은 번역 안 함
max_text_len = 2000         ; 이 글자 수 초과는 번역 안 함

; ── 오버레이 ──
font_size = 13              ; 번역 박스 글자 크기(px)
single_line_max_h = 40      ; 원문 높이가 이하면 한 줄로 보고 가로로 늘림
